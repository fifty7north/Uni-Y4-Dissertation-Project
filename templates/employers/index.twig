{% extends "index" %}
{% do craft.app.view.registerCssFile('@web/css/whoWeWorkWith.css') %}
{% do craft.app.view.registerJsFile('@web/js/whoWeWorkWith.js') %}
{% block content %}
	<section id="hero">
		<div id="hero-text">
			<h1>Employers</h1>
			<p>DYW Moray engages employers from across the region to make it easy to work with our college and schools and to provide more opportunities for young people to develop their employability skills. We would like all young people in Moray from the age of 3-24 years old to have some preparation for the world of work.</p>
		</div>
		<div id="hero-image-container">
			<img src="{{siteUrl}}images/hero/employers-hero-image.svg" alt="" id="hero-image">
		</div>
	</section>
	<section id="get-involved-section">
		<h2>How to get involved</h2>
		<div class="get-involved-cards">
			<div class="get-involved-card card-hover fade-in-animation">
				<div class="get-involved-card-image">
					<img src="{{siteUrl}}images/placeholder.webp">
				</div>
				<div class="get-involved-card-text">
					<h5>Offer Work Related Learning Experiences</h5>
					<p>Could you offer work experience, a workplace visit, or give a career talk? Work-related learning experiences are vital for inspiring the next generation of employees. Drop us a line to let us know what your business could offer.</p>
				</div>
			</div>
			<div class="get-involved-card card-hover fade-in-animation">
				<div class="get-involved-card-image">
					<img src="{{siteUrl}}images/placeholder.webp">
				</div>
				<div class="get-involved-card-text">
					<h5>Run a project with DYW Moray's support</h5>
					<p>Already got an innovative idea you want to pilot? A project given to pupils to work on with an employer can significantly develop their employability skills. Find out how we can help.</p>
				</div>
			</div>
			<div class="get-involved-card card-hover fade-in-animation">
				<div class="get-involved-card-image">
					<img src="{{siteUrl}}images/placeholder.webp">
				</div>
				<div class="get-involved-card-text">
					<h5>Partner with a School or UHI Moray</h5>
					<p>Partnering with local schools and colleges allows a common understanding to be developed about what skills and experiences young people require to be successful in the world of work. Read about some of our Case Studies with Education.</p>
				</div>
			</div>
			<div class="get-involved-card card-hover fade-in-animation">
				<div class="get-involved-card-image">
					<img src="{{siteUrl}}images/placeholder.webp">
				</div>
				<div class="get-involved-card-text">
					<h5>Become an Industry Ambassador</h5>
					<p>Are you bursting with pride about your industry and keen to share your passion with potential future recruits? DYW Moray needs Industry Ambassadors to act as a point of contact for their industry to offer support and guidance to those in education.</p>
				</div>
			</div>
			<div class="get-involved-card card-hover fade-in-animation">
				<div class="get-involved-card-image">
					<img src="{{siteUrl}}images/placeholder.webp">
				</div>
				<div class="get-involved-card-text">
					<h5>Recruit an Apprentice</h5>
					<p>Hiring an apprentice can reduce your recruitment costs, plug skills gaps, and increase productivity. DYW Moray and partners aim to increase the number of employers recruiting apprentices, and we are here to support you on your journey.</p>
				</div>
			</div>
			<div class="get-involved-card card-hover fade-in-animation">
				<div class="get-involved-card-image">
					<img src="{{siteUrl}}images/placeholder.webp">
				</div>
				<div class="get-involved-card-text">
					<h5>Volunteer to become a Mentor</h5>
					<p>Mentoring can transform young people's lives as they get the chance to speak to a professional one-to-one who is outwith their household and school. There are two fantastic mentoring programmes in Moray: Career Ready and Mentoring Young Talent.</p>
				</div>
			</div>
		</div>
	</section>
	<section id="benefits-section">
		<h2>How getting involved benefits employers</h2>
		<div id="benefits-list-container">
			<div>
				<img src="{{siteUrl}}images/hero/jobs-hero-plants.svg">
			</div>
			<ul class="fade-in-animation" id="benefits-list-employers">
				<li>Facilitates business growth and sustainability</li>
				<li>Raises company and industry profile</li>
				<li>Develops and energises staff</li>
				<li>Supports with succession planning</li>
				<li>Help give something back</li>
				<li>Streamlines recruitment process</li>
				<li>Creates a talent pipeline into the industry</li>
				<li>Contributes to corporate social responsibility</li>
			</ul>
			<div>
				<img src="{{siteUrl}}images/hero/educators-hero-image.svg">
			</div>
		</div>
	</section>
	<section id="find-out-more-section">
		<h2>Find out more about...</h2>
		<div class="find-out-more-container">
			<a href="{{siteUrl}}young_persons_guarantee" class="signpost card-hover fade-in-animation">
				<img src="{{siteUrl}}images/icons/YPG.png">
				<h4 class="highlight-effect-blue">Young Person's Guarantee</h4>
				<p>Find out how you can get involved in the Young Person's Guarantee.</p>
			</a>
			<a href="https://www.apprenticeships.scot/" class="signpost card-hover fade-in-animation">
				<img src="{{siteUrl}}images/icons/apprenticeship.png">
				<h4 class="highlight-effect-blue">Apprenticeships</h4>
				<p>There are over 100 types of apprenticeships available in Scotland. From construction to digital media, you can find one to suit your business.</p>
			</a>
			<a href="https://dywmoray.us14.list-manage.com/subscribe?u=1f7c9fcd6e5f65aaa681d7ac2&id=870f04e837" class="signpost card-hover fade-in-animation">
				<img src="{{siteUrl}}images/icons/newsletter.png">
				<h4 class="highlight-effect-blue">Newsletter</h4>
				<p>Keep up to date with our news and events by signing up to our newsletter.</p>
			</a>
		</div>
	</section>
{% endblock %}

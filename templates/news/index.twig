{% extends "index" %}
{% do craft.app.view.registerCssFile('@web/css/blog.css') %}
{% do craft.app.view.registerJsFile('@web/js/blog.js') %}
{% block content %}
	<section id="hero">
		<div id="hero-text">
			<h1>News</h1>
			<p>Stay up to date with DYW Moray news and find out about some of the people we've worked with.</p>
		</div>
		<div id="hero-image-container">
			<img src="{{siteUrl}}images/hero/blog-hero-image.svg" alt="News page hero image" id="hero-image">
		</div>
	</section>
	<section class="blog-list" id="blog-posts">
		<h2>News</h2>
		{% set newsPosts = craft.entries.section("news").all() %}
		{% for post in newsPosts %}
			<div href="{{post.url}}" class="blog-post card-hover fade-in-animation">
				<small>{{post.postDate|date("d M, Y")}}</small>
				<h5>{{post.title}}</h5>
				<p>{{post.postDescription}}</p>
				<div class="button">
					<a href="{{post.url}}" class="button-main primary-button">Read More</a>
					<div class="button-accent-1"></div>
					<div class="button-accent-2"></div>
				</div>
			</div>
		{% endfor %}
	</section>

{% endblock %}

{% extends "index" %}
{% do craft.app.view.registerCssFile('@web/css/home.css') %}
{% do craft.app.view.registerJsFile('@web/js/home.js') %}
{% block content %}

<section id="hero-section">
	<div id="hero-section-text">
		<h1>
			Bridging the gap between
			<span style="color: var(--accentBlue)">employers</span>,
			<span style="color: var(--accentPink)">educators</span>
			and
			<span style="color: var(--accentYellow)">young people</span>.
		</h1>
		<div id="hero-buttons">
			<div class="button">
				<a class="button-main primary-button">Find out more</a>
				<div class="button-accent-1"></div>
				<div class="button-accent-2"></div>
			</div>
			<div class="button">
				<a class="button-main secondary-button">Latest Jobs</a>
				<div class="button-accent-1"></div>
				<div class="button-accent-2"></div>
			</div>
		</div>
	</div>
	<div id="hero-section-image">
		<img src="{{siteUrl}}static/images/hero-image.png" alt="">
	</div>
</section>
<section id="signposts-section">
	<h2>Want to know more about who we work with?</h2>
	<div id="signposts-container">
		<a href="" class="homepage-signpost fade-in-animation">
			<img src="{{siteUrl}}static/images/suitcase.png">
			<h3 class="highlight-effect-blue">Employers</h3>
			<p>We bring employers on board as partners and link them up to schools and projects where they can make a real difference and inspire tomorrow's talent.</p>
		</a>
		<a href="" class="homepage-signpost fade-in-animation">
			<img src="{{siteUrl}}static/images/graduation-hat.png">
			<h3 class="highlight-effect-pink">Educators</h3>

			<p>We work with teachers, lecturers and early years educators to understand the curriculum they teach, and where Moray businesses can support.</p>
		</a>
		<a href="" class="homepage-signpost fade-in-animation">
			<img src="{{siteUrl}}static/images/school.png">
			<h3 class="highlight-effect-yellow">Young People</h3>

			<p>We organise a range of events throughout the year to help young people and their parents understand the range of opportunities available.</p>
		</a>
		<a href="" class="homepage-signpost fade-in-animation">
			<img src="{{siteUrl}}static/images/parents.png">
			<h3 class="highlight-effect-green">Parents</h3>

			<p>We're passionate about the importance our work has on education, young people, and businesses.</p>
		</a>
	</div>
</section>

{% endblock %}


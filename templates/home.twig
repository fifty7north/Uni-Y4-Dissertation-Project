{% extends "index" %}
{% do craft.app.view.registerCssFile('@web/css/home.css') %}
{% do craft.app.view.registerJsFile('@web/js/home.js') %}
{% block content %}
<section id="hero-section">
	<div id="hero-section-text">
		<h1>
			Bridging the gap between
			<span style="color: var(--accentBlue)">employers</span>,
			<span style="color: var(--accentPink)">educators</span>
			and
			<span style="color: var(--accentYellow)">young people</span>.
		</h1>
		<div id="hero-buttons">
			<div class="button">
				<a class="button-main primary-button" id="signposts-button">Find out more</a>
				<div class="button-accent-1"></div>
				<div class="button-accent-2"></div>
			</div>
			<div class="button">
				<a class="button-main secondary-button" id="latest-jobs-button">Latest Jobs</a>
				<div class="button-accent-1"></div>
				<div class="button-accent-2"></div>
			</div>
		</div>
	</div>
	<div id="hero-section-image">
		<img src="{{siteUrl}}static/images/home-hero-image.svg" alt="">
	</div>
</section>
<section id="signposts-section">
	<h2>Want to know more about who we work with?</h2>
	<div id="signposts-container">
		<a href="" class="homepage-signpost fade-in-animation">
			<img src="{{siteUrl}}static/images/icons/suitcase.png">
			<h3 class="highlight-effect-blue">Employers</h3>
			<p>We bring employers on board as partners and link them up to schools and projects where they can make a real difference and inspire tomorrow's talent.</p>
		</a>
		<a href="" class="homepage-signpost fade-in-animation">
			<img src="{{siteUrl}}static/images/icons/graduation-hat.png">
			<h3 class="highlight-effect-pink">Educators</h3>
			<p>We work with teachers, lecturers and early years educators to understand the curriculum they teach, and where Moray businesses can support.</p>
		</a>
		<a href="" class="homepage-signpost fade-in-animation">
			<img src="{{siteUrl}}static/images/icons/school.png">
			<h3 class="highlight-effect-yellow">Young People</h3>
			<p>We organise a range of events throughout the year to help young people and their parents understand the range of opportunities available.</p>
		</a>
		<a href="" class="homepage-signpost fade-in-animation">
			<img src="{{siteUrl}}static/images/icons/parents.png">
			<h3 class="highlight-effect-green">Parents</h3>
			<p>We're passionate about the importance our work has on education, young people, and businesses.</p>
		</a>
	</div>
</section>
<section id="stats-section">
	<div class="stat fade-in-animation">
		<div id="stat1" style="color: var(--accentBlue)">50+</div>
		<p>Sign ups to the young person's guarantee</p>
	</div>
	<div class="stat fade-in-animation">
		<div id="stat2" style="color: var(--accentPink)">500+</div>
		<p>Work inspiration activities delivered by young people</p>
	</div>
	<div class="stat fade-in-animation">
		<div id="stat3" style="color: var(--accentYellow)">20k+</div>
		<p>Work inspiration activities delivered to young people</p>
	</div>
</section>
<section id="latest-jobs-section">
	<h1>Latest Jobs</h1>
	<div id="latest-jobs-cards-container">
		{% set latestJobs = craft.entries.section("jobs").all()%}
		<div class="job-card fade-in-animation">
			<h5>{{latestJobs[0].title}}</h5>
			<div class="job-card-details">
				<small><span>Contract: </span>{{latestJobs[0].jobContract}}</small>
				<small><span>Salary: </span>{{latestJobs[0].jobSalary}}</small>
				<small><span>Employer: </span>{{latestJobs[0].jobEmployer}}</small>
				<small><span>Location: </span>{{latestJobs[0].jobLocation}}</small>
				<small><span>Closing Date: </span>{{latestJobs[0].jobClosingDate|date}}</small>
			</div>
			<div class="job-card-buttons">
				<div class="button">
					<a href="{{latestJobs[0].jobLink}}" class="button-main primary-button">Apply Now</a>
					<div class="button-accent-1"></div>
					<div class="button-accent-2"></div>
				</div>
				<div class="button">
					<a href="{{siteUrl}}jobs" class="button-main secondary-button job-card-description-button">View on Jobs Page</a>
					<div class="button-accent-1"></div>
					<div class="button-accent-2"></div>
				</div>
			</div>
		</div>
		<div class="job-card fade-in-animation">
			<h5>{{latestJobs[1].title}}</h5>
			<div class="job-card-details">
				<small><span>Contract: </span>{{latestJobs[1].jobContract}}</small>
				<small><span>Salary: </span>{{latestJobs[1].jobSalary}}</small>
				<small><span>Employer: </span>{{latestJobs[1].jobEmployer}}</small>
				<small><span>Location: </span>{{latestJobs[1].jobLocation}}</small>
				<small><span>Closing Date: </span>{{latestJobs[1].jobClosingDate|date}}</small>
			</div>
			<div class="job-card-buttons">
				<div class="button">
					<a href="{{latestJobs[1].jobLink}}" class="button-main primary-button">Apply Now</a>
					<div class="button-accent-1"></div>
					<div class="button-accent-2"></div>
				</div>
				<div class="button">
					<a href="{{siteUrl}}jobs" class="button-main secondary-button job-card-description-button">View on Jobs Page</a>
					<div class="button-accent-1"></div>
					<div class="button-accent-2"></div>
				</div>
			</div>
		</div>
		<div class="job-card fade-in-animation">
			<h5>{{latestJobs[2].title}}</h5>
			<div class="job-card-details">
				<small><span>Contract: </span>{{latestJobs[2].jobContract}}</small>
				<small><span>Salary: </span>{{latestJobs[2].jobSalary}}</small>
				<small><span>Employer: </span>{{latestJobs[2].jobEmployer}}</small>
				<small><span>Location: </span>{{latestJobs[2].jobLocation}}</small>
				<small><span>Closing Date: </span>{{latestJobs[2].jobClosingDate|date}}</small>
			</div>
			<div class="job-card-buttons">
				<div class="button">
					<a href="{{latestJobs[2].jobLink}}" class="button-main primary-button">Apply Now</a>
					<div class="button-accent-1"></div>
					<div class="button-accent-2"></div>
				</div>
				<div class="button">
					<a href="{{siteUrl}}jobs" class="button-main secondary-button job-card-description-button">View on Jobs Page</a>
					<div class="button-accent-1"></div>
					<div class="button-accent-2"></div>
				</div>
			</div>
		</div>
	</div>
</section>
<section id="get-in-touch-section">
	<h2>Learn more and get in touch</h2>
	<div id="get-in-touch-container">
		<a href="{{siteUrl}}events" class="homepage-signpost fade-in-animation">
			<img src="{{siteUrl}}static/images/icons/calendar.png">
			<h3 class="highlight-effect-pink">Events</h3>
			<p>Stay up to date with DYW Moray news and events, and find out about some of the people we have worked with.</p>
		</a>
		<a href="" class="homepage-signpost fade-in-animation">
			<img src="{{siteUrl}}static/images/icons/content-writing.png">
			<h3 class="highlight-effect-blue">Blog</h3>

			<p>We're passionate about the impact our work has on education, young people, and businesses - and we can't stop talking about it!</p>
		</a>
		<a href="" class="homepage-signpost fade-in-animation">
			<img src="{{siteUrl}}static/images/icons/newsletter.png">
			<h3 class="highlight-effect-yellow">Newsletter</h3>

			<p>Keep up to date with our news and events by signing up to our newsletter.</p>
		</a>
	</div>
</section>
{% endblock %}

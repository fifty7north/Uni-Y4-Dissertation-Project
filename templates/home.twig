{% extends "index" %}
{% do craft.app.view.registerCssFile('@web/css/home.css') %}
{% do craft.app.view.registerJsFile('@web/js/home.js') %}
{% block content %}
	<section id="home-hero-section">
		<div id="home-hero-section-text">
			<h1>
				Bridging the gap between
				<span style="color: var(--accentBlue)">employers</span>,
				<span style="color: var(--accentPink)">educators</span>
				and
				<span style="color: var(--accentYellow)">young people</span>.
			</h1>
			<div id="home-hero-buttons">
				<div class="button">
					<a class="button-main primary-button" id="signposts-button">Find out more</a>
					<div class="button-accent-1"></div>
					<div class="button-accent-2"></div>
				</div>
				<div class="button">
					<a class="button-main secondary-button" id="latest-jobs-button">Latest Jobs</a>
					<div class="button-accent-1"></div>
					<div class="button-accent-2"></div>
				</div>
			</div>
		</div>
		<div id="home-hero-section-image">
			<img src="{{siteUrl}}images/hero/home-hero-image.svg" alt="Home page hero image">
		</div>
	</section>
	<section id="signposts-section">
		<h2>Want to know more about who we work with?</h2>
		<div id="signposts-container">
			<a href="{{siteUrl}}employers" class="signpost card-hover fade-in-animation">
				<img src="{{siteUrl}}images/icons/suitcase.png" alt="Employers icon">
				<h3 class="highlight-effect-blue">Employers</h3>
				<p>We bring employers on board as partners and link them up to schools and projects where they can make a real difference and inspire tomorrow's talent.</p>
			</a>
			<a href="{{siteUrl}}educators" class="signpost card-hover fade-in-animation">
				<img src="{{siteUrl}}images/icons/graduation-hat.png" alt="Educators icon">
				<h3 class="highlight-effect-pink">Educators</h3>
				<p>We work with teachers, lecturers and early years educators to understand the curriculum they teach, and where Moray businesses can support.</p>
			</a>
			<a href="{{siteUrl}}young_people_&_parents" class="signpost card-hover fade-in-animation">
				<img src="{{siteUrl}}images/icons/school.png" alt="Young people icon">
				<h3 class="highlight-effect-yellow">Young People</h3>
				<p>We organise a range of events throughout the year to help young people and their parents understand the range of opportunities available.</p>
			</a>
			<a href="{{siteUrl}}young_people_&_parents" class="signpost card-hover fade-in-animation">
				<img src="{{siteUrl}}images/icons/parents.png" alt="Parents icon">
				<h3 class="highlight-effect-green">Parents</h3>
				<p>We're passionate about the importance our work has on education, young people, and businesses.</p>
			</a>
		</div>
	</section>
	<section id="stats-section">
		<div class="stat fade-in-animation">
			<div id="stat1" style="color: var(--accentBlue)">
				<span class="stat-number fade-in-animation"></span>
				<span>+</span>
			</div>
			<p>Sign ups to the young person's guarantee</p>
		</div>
		<div class="stat fade-in-animation">
			<div id="stat2" style="color: var(--accentPink)">
				<span class="stat-number fade-in-animation"></span>
				<span>+</span>
			</div>
			<p>Work inspiration activities delivered by young people</p>
		</div>
		<div class="stat fade-in-animation">
			<div id="stat3" style="color: var(--accentYellow)">
				<span class="stat-number fade-in-animation"></span>
				<span>k+</span>
			</div>
			<p>Work inspiration activities delivered to young people</p>
		</div>
	</section>
	<section id="latest-jobs-section">
		<h1>Latest Jobs</h1>
		<div id="latest-jobs-cards-container">
			{% set latestJobs = craft.entries.section("jobs").all()%}
			{% if latestJobs|length > 0 %}
				<div class="job-card card-hover fade-in-animation">
					<h5>{{latestJobs[0].title}}</h5>
					{% set image1 = latestJobs[0].image.one() %}
					<img src="{{image1.url}}" alt="{{latestJobs[0].jobEmployer}}">
					<div class="job-card-details">
						<small>
							<span>Contract:
							</span>
							{{latestJobs[0].jobContract}}</small>
						<small>
							<span>Salary:
							</span>
							{{latestJobs[0].jobSalary}}</small>
						<small>
							<span>Employer:
							</span>
							{{latestJobs[0].jobEmployer}}</small>
						<small>
							<span>Location:
							</span>
							{{latestJobs[0].jobLocation}}</small>
						<small>
							<span>Closing Date:
							</span>
							{{latestJobs[0].jobClosingDate|date}}</small>
					</div>
					<div class="job-card-buttons">
						<div class="button">
							<a href="{{latestJobs[0].jobLink}}" class="button-main primary-button">Apply Now</a>
							<div class="button-accent-1"></div>
							<div class="button-accent-2"></div>
						</div>
						<div class="button">
							<a href="{{siteUrl}}jobs" class="button-main secondary-button job-card-description-button">View on Jobs Page</a>
							<div class="button-accent-1"></div>
							<div class="button-accent-2"></div>
						</div>
					</div>
				</div>
			{% endif %}
			{% if latestJobs|length > 1 %}
				<div class="job-card card-hover fade-in-animation">
					<h5>{{latestJobs[1].title}}</h5>
					{% set image2 = latestJobs[1].image.one() %}
					<img src="{{image2.url}}" alt="{{latestJobs[1].jobEmployer}}">
					<div class="job-card-details">
						<small>
							<span>Contract:
							</span>
							{{latestJobs[1].jobContract}}</small>
						<small>
							<span>Salary:
							</span>
							{{latestJobs[1].jobSalary}}</small>
						<small>
							<span>Employer:
							</span>
							{{latestJobs[1].jobEmployer}}</small>
						<small>
							<span>Location:
							</span>
							{{latestJobs[1].jobLocation}}</small>
						<small>
							<span>Closing Date:
							</span>
							{{latestJobs[1].jobClosingDate|date}}</small>
					</div>
					<div class="job-card-buttons">
						<div class="button">
							<a href="{{latestJobs[1].jobLink}}" class="button-main primary-button">Apply Now</a>
							<div class="button-accent-1"></div>
							<div class="button-accent-2"></div>
						</div>
						<div class="button">
							<a href="{{siteUrl}}jobs" class="button-main secondary-button job-card-description-button">View on Jobs Page</a>
							<div class="button-accent-1"></div>
							<div class="button-accent-2"></div>
						</div>
					</div>
				</div>
			{% endif %}
			{% if latestJobs|length > 2 %}
				<div class="job-card card-hover fade-in-animation">
					<h5>{{latestJobs[2].title}}</h5>
					{% set image3 = latestJobs[2].image.one() %}
					<img src="{{image3.url}}" alt="{{latestJobs[2].jobEmployer}}">
					<div class="job-card-details">
						<small>
							<span>Contract:
							</span>
							{{latestJobs[2].jobContract}}</small>
						<small>
							<span>Salary:
							</span>
							{{latestJobs[2].jobSalary}}</small>
						<small>
							<span>Employer:
							</span>
							{{latestJobs[2].jobEmployer}}</small>
						<small>
							<span>Location:
							</span>
							{{latestJobs[2].jobLocation}}</small>
						<small>
							<span>Closing Date:
							</span>
							{{latestJobs[2].jobClosingDate|date}}</small>
					</div>
					<div class="job-card-buttons">
						<div class="button">
							<a href="{{latestJobs[2].jobLink}}" class="button-main primary-button">Apply Now</a>
							<div class="button-accent-1"></div>
							<div class="button-accent-2"></div>
						</div>
						<div class="button">
							<a href="{{siteUrl}}jobs" class="button-main secondary-button job-card-description-button">View on Jobs Page</a>
							<div class="button-accent-1"></div>
							<div class="button-accent-2"></div>
						</div>
					</div>
				</div>
			{% endif %}
		</div>
	</section>
	<section id="latest-career-stories-section">
		<h1>Latest Career Stories</h1>
		<div id="career-stories-list">
			{% set careerStories = craft.entries.section("careerStories").all() %}
			{% if careerStories|length > 0 %}
				<div class="career-story-group">
					<div class="career-story-image card-hover fade-in-animation">
						{% set careerStoryImage1 = careerStories[0].image.one() %}
						<img src="{{careerStoryImage1.getUrl("careerStoryHomePageCard")}}" alt="{{careerStories[0].title}}">
					</div>
					<div class="career-story-text card-hover fade-in-animation">
						<h5>{{careerStories[0].title}}</h5>
						<p>{{careerStories[0].postDescription}}</p>
						<div class="button">
							<a href="{{careerStories[0].url}}" class="button-main primary-button">Read More</a>
							<div class="button-accent-1"></div>
							<div class="button-accent-2"></div>
						</div>
					</div>
				</div>
			{% endif %}
			{% if careerStories|length > 1 %}
				<div class="career-story-group" id="career-story-group-2">
					<div class="career-story-text card-hover fade-in-animation">
						<h5>{{careerStories[1].title}}</h5>
						<p>{{careerStories[1].postDescription}}</p>
						<div class="button">
							<a href="{{careerStories[1].url}}" class="button-main primary-button">Read More</a>
							<div class="button-accent-1"></div>
							<div class="button-accent-2"></div>
						</div>
					</div>
					<div class="career-story-image card-hover fade-in-animation">
						{% set careerStoryImage2 = careerStories[1].image.one() %}
						<img src="{{careerStoryImage2.getUrl("careerStoryHomePageCard")}}" alt="{{careerStories[0].title}}">
					</div>
				</div>
			{% endif %}
		</div>
	</section>
	{% set otherPages = craft.entries.section("otherPages").all() %}
	{% if otherPages|length > 0 %}
		<section id="other-pages-section">
			<h1>Other Pages</h1>
			<div id="other-pages-container">
				{% for page in otherPages %}
					<div class="signpost card-hover fade-in-animation">
						<a href={{page.url}}>
							<h3>{{page.title}}</h3>
							<p>{{page.pageDescription}}</p>
						</a>
					</div>
				{% endfor %}
			</div>
		</section>
	{% endif %}
	<section id="get-in-touch-section">
		<h2>Learn more and get in touch</h2>
		<div id="get-in-touch-container">
			<a href="{{siteUrl}}events" class="signpost card-hover fade-in-animation">
				<img src="{{siteUrl}}images/icons/calendar.png" alt="Events icon">
				<h3 class="highlight-effect-pink">Events</h3>
				<p>Stay up to date with DYW Moray news and events, and find out about some of the people we have worked with.</p>
			</a>
			<a href="{{siteUrl}}blog" class="signpost card-hover fade-in-animation">
				<img src="{{siteUrl}}images/icons/content-writing.png" alt="Local stories icon">
				<h3 class="highlight-effect-blue">Local Stories</h3>
				<p>We're passionate about the impact our work has on education, young people, and businesses - and we can't stop talking about it!</p>
			</a>
			<a href="https://dywmoray.us14.list-manage.com/subscribe?u=1f7c9fcd6e5f65aaa681d7ac2&id=870f04e837" class="signpost card-hover fade-in-animation">
				<img src="{{siteUrl}}images/icons/newsletter.png" alt="Newsletter icon">
				<h3 class="highlight-effect-yellow">Newsletter</h3>
				<p>Keep up to date with our news and events by signing up to our newsletter.</p>
			</a>
		</div>
	</section>
{% endblock %}

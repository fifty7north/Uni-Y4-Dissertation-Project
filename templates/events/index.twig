{% extends "index" %}
{% do craft.app.view.registerCssFile('@web/css/events.css') %}
{% do craft.app.view.registerJsFile('@web/js/events.js') %}
{% block content %}
	<section id="hero">
		<div id="hero-text">
			<h1>Events</h1>
			<p>Stay up to date with DYW Moray events, and a list of employer requests for events across schools/colleges in Moray.</p>
			<div id="hero-buttons">
				<div class="button">
					<a class="button-main primary-button" id="dyw-events-button">DYW Events</a>
					<div class="button-accent-1"></div>
					<div class="button-accent-2"></div>
				</div>
				<div class="button">
					<a class="button-main secondary-button" id="school-events-button">School Events</a>
					<div class="button-accent-1"></div>
					<div class="button-accent-2"></div>
				</div>
			</div>
		</div>
		<div id="hero-image-container">
			<img src="{{siteUrl}}static/images/events-hero-image.svg" alt="" id="hero-image">
		</div>
	</section>
	<section id="dyw-events-section">
		<h2>DYW Events</h2>
		<div id="dyw-events-list">
			{% set dywEvents = craft.entries.section("dywEvents").all() %}
			{% if dywEvents > 0%}
				{% for event in dywEvents|sort((a, b) => a.eventStartDate|date("Ymd") > b.eventStartDate|date("Ymd")) %}
					<div class="event-card card-hover fade-in-animation">
						<small>
							{{event.eventStartDate|date("jS M, Y")}}
							{% if event.eventEndDate %}
								-
								{{event.eventEndDate|date("jS M, Y")}}
							{% endif %}
						</small>
						<h5>{{event.title}}</h5>
						<small class="event-card-description">{{event.eventDescription|nl2br}}</small>
						<div class="event-card-buttons">
							<div class="button">
								<a href="{{event.eventLink}}" class="button-main primary-button">Apply Now</a>
								<div class="button-accent-1"></div>
								<div class="button-accent-2"></div>
							</div>
							<div class="button">
								<a class="button-main secondary-button event-card-description-button">View More</a>
								<div class="button-accent-1"></div>
								<div class="button-accent-2"></div>
							</div>
						</div>
					</div>
				{% endfor %}
			{% endif %}
		</div>
	</section>

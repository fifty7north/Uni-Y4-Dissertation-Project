{% extends "index" %}
{% do craft.app.view.registerCssFile('@web/css/whoWeWorkWith.css') %}
{% do craft.app.view.registerJsFile('@web/js/whoWeWorkWith.js') %}
{% block content %}
	<section id="hero">
		<div id="hero-text">
			<h1>Educators</h1>
			<p>Educators are a key part of our collaborative working towards developing the employability of our young people in Moray.</p>
		</div>
		<div id="hero-image-container">
			<img src="{{siteUrl}}images/hero/educators-hero-image.svg" alt="" id="hero-image">
		</div>
	</section>
	<section id="get-involved-section">
		<h2>Meet our DYW Moray school coordinators</h2>
		<div class="get-involved-cards">
			<div class="get-involved-card card-hover fade-in-animation">
				<div class="get-involved-card-image">
					<img src="{{siteUrl}}images/placeholder.webp">
				</div>
				<div class="get-involved-card-text">
					<h5>Beth Pickup</h5>
					<p>Elgin High School & Milnes High School</p>
				</div>
			</div>
			<div class="get-involved-card card-hover fade-in-animation">
				<div class="get-involved-card-image">
					<img src="{{siteUrl}}images/placeholder.webp">
				</div>
				<div class="get-involved-card-text">
					<h5>Carinne Taylor</h5>
					<p>Forres Academy & Elgin Academy</p>
				</div>
			</div>
			<div class="get-involved-card card-hover fade-in-animation">
				<div class="get-involved-card-image">
					<img src="{{siteUrl}}images/placeholder.webp">
				</div>
				<div class="get-involved-card-text">
					<h5>Jolene Young</h5>
					<p>Lossiemouth High School & Mucke High School</p>
				</div>
			</div>
			<div class="get-involved-card card-hover fade-in-animation">
				<div class="get-involved-card-image">
					<img src="{{siteUrl}}images/placeholder.webp">
				</div>
				<div class="get-involved-card-text">
					<h5>Aimee Stephen</h5>
					<p>Business Liaison (College Link)</p>
				</div>
			</div>
			<div class="get-involved-card card-hover fade-in-animation">
				<div class="get-involved-card-image">
					<img src="{{siteUrl}}images/placeholder.webp">
				</div>
				<div class="get-involved-card-text">
					<h5>Emma Winchester</h5>
					<p>Keith Grammar School & Speyside High School</p>
				</div>
			</div>
		</div>
	</section>
	<section id="benefits-section" style="padding: 80px 12.5%">
		<h2>How DYW Moray supports schools & colleges</h2>
		<div class="get-involved-cards">
			<div class="get-involved-card card-hover fade-in-animation">
				<div class="get-involved-card-image">
					<img src="{{siteUrl}}images/placeholder.webp">
				</div>
				<div class="get-involved-card-text">
					<h5>Facilitate Career Talks</h5>
					<p>Career Talks can ignite a spark in young people that can positively enhance their school learning experience.</p>
				</div>
			</div>
			<div class="get-involved-card card-hover fade-in-animation">
				<div class="get-involved-card-image">
					<img src="{{siteUrl}}images/placeholder.webp">
				</div>
				<div class="get-involved-card-text">
					<h5>Arrange Workplace Visits</h5>
					<p>Visiting local worksites allows young people to see and experience real workplaces and can inspire them for their future career choices.</p>
				</div>
			</div>
			<div class="get-involved-card card-hover fade-in-animation">
				<div class="get-involved-card-image">
					<img src="{{siteUrl}}images/placeholder.webp">
				</div>
				<div class="get-involved-card-text">
					<h5>Employer Led Workshops</h5>
					<p>Workshops that fit into curriculum can be a great way of linking theory to the world of work.</p>
				</div>
			</div>
			<div class="get-involved-card card-hover fade-in-animation">
				<div class="get-involved-card-image">
					<img src="{{siteUrl}}images/placeholder.webp">
				</div>
				<div class="get-involved-card-text">
					<h5>CV Preparation & Mock Interviews</h5>
					<p>Prepare your young people for their future by hosting CV Preparation sessions and Mock Interviews with local employers.</p>
				</div>
			</div>
			<div class="get-involved-card card-hover fade-in-animation">
				<div class="get-involved-card-image">
					<img src="{{siteUrl}}images/placeholder.webp">
				</div>
				<div class="get-involved-card-text">
					<h5>Industry Designed Projects</h5>
					<p>Projects designed by employers with their industry in mind can help develop young peoples employability skills significantly.</p>
				</div>
			</div>
			<div class="get-involved-card card-hover fade-in-animation">
				<div class="get-involved-card-image">
					<img src="{{siteUrl}}images/placeholder.webp">
				</div>
				<div class="get-involved-card-text">
					<h5>Promote Local Opportunities</h5>
					<p>All school opportunities can be accessed through our
						<span>
							<a href="{{siteUrl}}events">events page.</a>
						</span>
						We advertise local apprenticeship and job opportunities through our
						<span>
							<a href="{{siteUrl}}jobs">jobs page</a>
						</span>
						and through our "jobs of the week" flier which is sent directly to schools every Friday.</p>

				</div>
			</div>
		</div>
	</section>
	<section id="find-out-more-section">
		<h2>Find out more about...</h2>
		<div class="find-out-more-container">
			<a href="{{siteUrl}}events#school-events-section" class="signpost card-hover fade-in-animation">
				<img src="{{siteUrl}}images/icons/YPG.png">
				<h4 class="highlight-effect-pink">School Events</h4>
				<p>Find out how you can get involved in the Young Person's Guarantee.</p>
			</a>
			<a href="https://www.apprenticeships.scot/" class="signpost card-hover fade-in-animation">
				<img src="{{siteUrl}}images/icons/apprenticeship.png">
				<h4 class="highlight-effect-pink">Apprenticeships</h4>
				<p>Apprenticeships.scot gives you all of the information you need on the apprenticeships that are on offer for your students.</p>
			</a>
			<a href="https://dywmoray.us14.list-manage.com/subscribe?u=1f7c9fcd6e5f65aaa681d7ac2&id=870f04e837" class="signpost card-hover fade-in-animation">
				<img src="{{siteUrl}}images/icons/newsletter.png">
				<h4 class="highlight-effect-pink">Newsletter</h4>
				<p>Keep up to date with our news and events by signing up to our newsletter.</p>
			</a>
		</div>
	</section>
{% endblock %}

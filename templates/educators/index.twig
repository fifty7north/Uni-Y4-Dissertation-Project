{% extends "index" %}
{% do craft.app.view.registerCssFile('@web/css/whoWeWorkWith.css') %}
{% do craft.app.view.registerJsFile('@web/js/whoWeWorkWith.js') %}
{% block content %}
	<section id="hero">
		<div id="hero-text">
			<h1>Educators</h1>
			<p>Educators are a key part of our collaborative working towards developing the employability of our young people in Moray.</p>
		</div>
		<div id="hero-image-container">
			<img src="{{siteUrl}}images/hero/educators-hero-image.svg" alt="Educators page hero image" id="hero-image">
		</div>
	</section>
	<section id="get-involved-section">
		<h2>Meet our DYW Moray school coordinators</h2>
		<div class="get-involved-cards">
			<div class="get-involved-card card-hover fade-in-animation">
				<div class="get-involved-card-image">
					<img src="{{siteUrl}}images/educators/Beth-Pickup.jpg" alt="Beth Pickup">
				</div>
				<div class="get-involved-card-text">
					<h5>Beth Pickup</h5>
					<p>Elgin High School & Milnes High School</p>
				</div>
			</div>
			<div class="get-involved-card card-hover fade-in-animation">
				<div class="get-involved-card-image">
					<img src="{{siteUrl}}images/educators/Carinne-Taylor.jpg" alt="Carinne Taylor">
				</div>
				<div class="get-involved-card-text">
					<h5>Carinne Taylor</h5>
					<p>Forres Academy & Elgin Academy</p>
				</div>
			</div>
			<div class="get-involved-card card-hover fade-in-animation">
				<div class="get-involved-card-image">
					<img src="{{siteUrl}}images/educators/Jolene-Young.jpg" alt="Jolene Young">
				</div>
				<div class="get-involved-card-text">
					<h5>Jolene Young</h5>
					<p>Lossiemouth High School & Mucke High School</p>
				</div>
			</div>
			<div class="get-involved-card card-hover fade-in-animation">
				<div class="get-involved-card-image">
					<img src="{{siteUrl}}images/educators/Aimee-Stephen.jpg" alt="Aimee Stephen">
				</div>
				<div class="get-involved-card-text">
					<h5>Aimee Stephen</h5>
					<p>Business Liaison (College Link)</p>
				</div>
			</div>
			<div class="get-involved-card card-hover fade-in-animation">
				<div class="get-involved-card-image">
					<img src="{{siteUrl}}images/educators/Emma-Winchester.jpg" alt="Emma Winchester">
				</div>
				<div class="get-involved-card-text">
					<h5>Emma Winchester</h5>
					<p>Keith Grammar School & Speyside High School</p>
				</div>
			</div>
		</div>
	</section>
	<section id="benefits-section">
		<h2>How getting involved benefits educators</h2>
		<div id="benefits-list-container">
			<div>
				<img src="{{siteUrl}}images/hero/jobs-hero-plants.svg" alt="Man helping girl in wheelchair">
			</div>
			<ul class="fade-in-animation" id="benefits-list-educators">
				<li>Facilitate career talks</li>
				<li>Arrange workplace visits</li>
				<li>Employer lead workshops</li>
				<li>CV preparation and mock interviews</li>
				<li>Industry designed projects</li>
				<li>Promote local opportunities</li>
			</ul>
			<div>
				<img src="{{siteUrl}}images/hero/educators-hero-image.svg" alt="Teacher talking to students">
			</div>
		</div>
	</section>
	<section id="find-out-more-section">
		<h2>Find out more about...</h2>
		<div class="find-out-more-container">
			<a href="{{siteUrl}}events#school-events-section" class="signpost card-hover fade-in-animation">
				<img src="{{siteUrl}}images/icons/calendar.png" alt="Events icon">
				<h4 class="highlight-effect-pink">School Events</h4>
				<p>Stay up to date with a list of employer requests for events across schools/colleges in Moray.</p>
			</a>
			<a href="https://www.apprenticeships.scot/" class="signpost card-hover fade-in-animation">
				<img src="{{siteUrl}}images/icons/apprenticeship.png" alt="Apprenticeships icon">
				<h4 class="highlight-effect-pink">Apprenticeships</h4>
				<p>Apprenticeships.scot gives you all of the information you need on the apprenticeships that are on offer for your students.</p>
			</a>
			<a href="https://dywmoray.us14.list-manage.com/subscribe?u=1f7c9fcd6e5f65aaa681d7ac2&id=870f04e837" class="signpost card-hover fade-in-animation">
				<img src="{{siteUrl}}images/icons/newsletter.png" alt="Newsletter icon">
				<h4 class="highlight-effect-pink">Newsletter</h4>
				<p>Keep up to date with our news and events by signing up to our newsletter.</p>
			</a>
		</div>
	</section>
{% endblock %}

{% extends "index" %}
{% do craft.app.view.registerCssFile('@web/css/jobs.css') %}
{% do craft.app.view.registerJsFile('@web/js/jobs.js') %}
{% block content %}
<section id="jobs-hero">
    <div id="jobs-hero-text">
        <h1>Jobs</h1>
        <p>To make it easier for young people in Moray to find opportunities, we have listed a variety of jobs that are currently available for you to apply below.</p>
    </div>
    <div id="jobs-hero-image-container">
        <img src="{{siteUrl}}static/images/jobs-hero-home.svg" alt="" id="jobs-hero-image">
    </div>
</section>
<section id="jobs-list">
    {% set jobs = craft.entries.section("jobs").all() %}
    {% for job in jobs %}
        <div class="job-card fade-in-animation">
            <h5>{{job.title}}</h5>
            <div class="job-card-details">
                <small><span>Contract: </span>{{job.jobContract}}</small>
                <small><span>Salary: </span>{{job.jobSalary}}</small>
                <small><span>Employer: </span>{{job.jobEmployer}}</small>
                <small><span>Location: </span>{{job.jobLocation}}</small>
                <small><span>Closing Date: </span>{{job.jobClosingDate|date}}</small>
            </div>
            <small class="job-card-description">{{job.jobDescription|nl2br}}</small>
            <div class="job-card-buttons">
                <div class="button">
                    <a href="{{job.jobApplicationLink}}" class="button-main primary-button">Apply Now</a>
                    <div class="button-accent-1"></div>
                    <div class="button-accent-2"></div>
                </div>
                <div class="button">
                    <a class="button-main secondary-button job-card-description-button">View More</a>
                    <div class="button-accent-1"></div>
                    <div class="button-accent-2"></div>
                </div>
            </div>
        </div>
    {% endfor %}
</section>

{% endblock %}

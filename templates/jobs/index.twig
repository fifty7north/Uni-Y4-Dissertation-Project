{% extends "index" %}
{% do craft.app.view.registerCssFile('@web/css/jobs.css') %}
{% do craft.app.view.registerJsFile('@web/js/jobs.js') %}
{% block content %}
	<section id="hero">
		<div id="hero-text">
			<h1>Jobs</h1>
			<p>To make it easier for young people in Moray to find opportunities, we have listed a variety of jobs that are currently available for you to apply below.</p>
			<div id="hero-buttons">
				<div class="button">
					<a class="button-main primary-button" id="jobs-button">Jobs</a>
					<div class="button-accent-1"></div>
					<div class="button-accent-2"></div>
				</div>
				<div class="button">
					<a class="button-main secondary-button" id="help-button">Job Resources</a>
					<div class="button-accent-1"></div>
					<div class="button-accent-2"></div>
				</div>
			</div>
		</div>
		<div id="hero-image-container">
			<img src="{{siteUrl}}images/hero/jobs-hero-home.svg" alt="Jobs hero image" id="hero-image">
		</div>
	</section>
	<section id="jobs-list">
		{% set jobs = craft.entries.section("jobs").all() %}
		{% if jobs|length > 0 %}
			{% for job in jobs %}
				<div class="job-card card-hover fade-in-animation">
					{% if job.ypgJobGuarantee == true %}
						<div class="ypg">YPG Guarantee</div>
						<h5>{{job.title}}</h5>
					{% else %}
						<div class="no-ypg"></div>
						<h5>{{job.title}}</h5>
					{% endif %}
					{% set image = job.image.one() %}
					<img src="{{image.url}}" alt="{{job.jobEmployer}}">
					<div class="job-card-details">
						<small>
							<span>Contract:
							</span>
							{{job.jobContract}}</small>
						<small>
							<span>Salary:
							</span>
							{{job.jobSalary}}</small>
						<small>
							<span>Employer:
							</span>
							{{job.jobEmployer}}</small>
						<small>
							<span>Location:
							</span>
							{{job.jobLocation}}</small>
						{% if job.jobClosingDate|length > 0 %}
							<small>
								<span>Closing Date:
								</span>
								{{job.jobClosingDate}}</small>
						{% endif %}
					</div>
					<small class="job-card-description">{{job.jobDescription|nl2br}}</small>
					<div class="job-card-buttons">
						<div class="button">
							<a href="{{job.jobLink}}" class="button-main primary-button">Apply Now</a>
							<div class="button-accent-1"></div>
							<div class="button-accent-2"></div>
						</div>
						<div class="button">
							<a class="button-main secondary-button job-card-description-button">View More</a>
							<div class="button-accent-1"></div>
							<div class="button-accent-2"></div>
						</div>
					</div>
				</div>
			{% endfor %}
		{% else %}
			<div id="job-error">
				<h2>Error: Could not load jobs</h2>
			</div>
		{% endif %}
	</section>
	<section id="help-section">
		<h2>Job Resources</h2>
		<div id="help-container">
			<a href="https://www.myworldofwork.co.uk/interviews-0" class="signpost card-hover fade-in-animation">
				<img src="{{siteUrl}}images/icons/apprenticeship.png" alt="Interview icon">
				<h3 class="highlight-effect-pink">Interview Tips</h3>
				<p>Interviews can be stressful, but they don't have to be! Click here for some useful interview tips that could help you secure a job.</p>
			</a>
			<a href="https://dywmoray.co.uk/news-events/cv-template-examples-and-advice-documents" class="signpost card-hover fade-in-animation">
				<img src="{{siteUrl}}images/icons/content-writing.png" alt="CV icon">
				<h3 class="highlight-effect-blue">CV Advice</h3>
				<p>Looking to create your CV but are looking some help? Click here for come helpful CV and application templates and advice.</p>
			</a>
			<a href="https://www.myworldofwork.co.uk/schoolleaverstoolkit" class="signpost card-hover fade-in-animation">
				<img src="{{siteUrl}}images/icons/school.png" alt="School leavers icon">
				<h3 class="highlight-effect-yellow">School Leavers</h3>
				<p>There's lots of support out there, but we know it can be tricky to find information you need, at the right time. Click here to access the School Leaver Toolkit which provides lots of information that is helpful now and in the future.</p>
			</a>
		</div>
	</section>
{% endblock %}
